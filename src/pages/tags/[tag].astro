---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
	const allPosts = await getCollection('blog');
	const uniqueTags = [...new Set(allPosts.map((post) => post.data.tags || []).flat())];
	
	return uniqueTags.map((tag) => {
		const filteredPosts = allPosts.filter((post) => post.data.tags?.includes(tag));
		return {
			params: { tag },
			props: { posts: filteredPosts },
		};
	});
}

const { tag } = Astro.params;
const { posts } = Astro.props;

// Sort by date
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Premium Tag Mapping for Mundo Trilhos
const tagMap = {
	// Modais de Transporte
	'vlt': {
		title: 'Mobilidade Urbana',
		subtitle: 'Veículos Leves sobre Trilhos (VLT)',
		description: 'Acompanhe as principais novidades, inovações tecnológicas e projetos de VLTs que transformam a mobilidade urbana nas cidades brasileiras e globais.',
		image: '/images/tags/vlt.png',
		color: 'linear-gradient(135deg, #1e3c72, #2a5298)'
	},
	'alta-velocidade': {
		title: 'Alta Velocidade',
		subtitle: 'Trens de Alta Velocidade (TAV)',
		description: 'A fronteira da velocidade sobre trilhos. Projetos, parcerias internacionais e o desenvolvimento das redes de alta velocidade pelo mundo.',
		image: '/images/tags/alta-velocidade.png',
		color: 'linear-gradient(135deg, #cb2d3e, #ef473a)'
	},
	'metro': {
		title: 'Sistemas Metropolitanos',
		subtitle: 'Metrôs & Subterrâneos',
		description: 'A espinha dorsal do transporte de alta capacidade. Expansões, novas linhas, inovações em trens autônomos (UTO) e tecnologia CBTC.',
		image: '/images/tags/metro.png',
		color: 'linear-gradient(135deg, #0052D4, #4364F7)'
	},
	'monotrilho': {
		title: 'Transporte Elevado',
		subtitle: 'Sistemas de Monotrilho',
		description: 'Tecnologia elevada de alta eficiência espacial. Automação, vigas-guia e as novidades das principais linhas metropolitanas.',
		image: '/images/tags/monotrilho.png',
		color: 'linear-gradient(135deg, #f7971e, #ffd200)'
	},
	'carga': {
		title: 'Logística & Transporte',
		subtitle: 'Ferrovias de Carga',
		description: 'O escoamento de grãos, minérios e bens manufaturados. A infraestrutura estratégica que move a economia continental.',
		image: '/images/tags/carga.png',
		color: 'linear-gradient(135deg, #56ab2f, #a8e063)'
	},
	'regional': {
		title: 'Conexão Metropolitana',
		subtitle: 'Trens Regionais',
		description: 'O transporte que encurta distâncias entre cidades vizinhas, integrando regiões e promovendo o desenvolvimento sustentável.',
		image: '/images/tags/default.png',
		color: 'linear-gradient(135deg, #00b4db, #0083b0)'
	},
	'turismo': {
		title: 'Patrimônio & História',
		subtitle: 'Trens Turísticos',
		description: 'A nostalgia do vapor e da história ferroviária preservada. Rotas históricas, passeios de Maria Fumaça e preservação da memória ferroviária.',
		image: '/images/tags/default.png',
		color: 'linear-gradient(135deg, #7b4397, #dc2430)'
	},
	// Regiões / Geográficos
	'sao-paulo': {
		title: 'Estado de São Paulo',
		subtitle: 'São Paulo Ferroviário',
		description: 'O maior polo de transporte sobre trilhos do país: novidades da CPTM, Metrô de São Paulo, concessões e ferrovias paulistas.',
		image: '/images/tags/default.png',
		color: 'linear-gradient(135deg, #2c3e50, #3498db)'
	},
	'rio-de-janeiro': {
		title: 'Estado do Rio de Janeiro',
		subtitle: 'Rio de Janeiro Ferroviário',
		description: 'Projetos de mobilidade na capital fluminense, SuperVia, VLT Carioca, MetrôRio e a infraestrutura logística do estado.',
		image: '/images/tags/default.png',
		color: 'linear-gradient(135deg, #0f2027, #203a43, #2c5364)'
	},
	'brasil': {
		title: 'Infraestrutura Nacional',
		subtitle: 'Ferrovias do Brasil',
		description: 'A política nacional de transportes, o Novo PAC, investimentos federais e a grande retomada do modal ferroviário no país.',
		image: '/images/tags/default.png',
		color: 'linear-gradient(135deg, #11998e, #38ef7d)'
	}
};

const meta = tagMap[tag] || {
	title: 'Tag do Mundo Trilhos',
	subtitle: tag.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' '),
	description: `Notícias e análises aprofundadas sobre ${tag.split('-').join(' ')} no portal Mundo Trilhos.`,
	image: '/images/tags/default.png',
	color: 'linear-gradient(135deg, #2f3640, #57606f)'
};
---

<!doctype html>
<html lang="pt-br">
	<head>
		<BaseHead title={`${meta.subtitle} - ${SITE_TITLE}`} description={meta.description} />
		<style define:vars={{ bgGradient: meta.color }}>
			@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@800&family=Outfit:wght@400;500;600;700&display=swap');

			main {
				max-width: 1000px;
				margin: 0 auto;
				padding: 0 1.5rem;
			}
			.tag-hero {
				position: relative;
				border-radius: 24px;
				min-height: 380px;
				display: flex;
				flex-direction: column;
				justify-content: flex-end;
				align-items: flex-start;
				padding: 3.5rem;
				margin-bottom: 4rem;
				margin-top: 2rem;
				box-shadow: 0 20px 40px rgba(0,0,0,0.15);
				overflow: hidden;
				color: white;
				background-color: #1a1a1a;
			}
			.tag-hero-bg {
				position: absolute;
				top: 0; left: 0; right: 0; bottom: 0;
				background-size: cover;
				background-position: center;
				transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
				z-index: 1;
			}
			.tag-hero:hover .tag-hero-bg {
				transform: scale(1.04);
			}
			.tag-hero-overlay {
				position: absolute;
				top: 0; left: 0; right: 0; bottom: 0;
				background: linear-gradient(to top, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0.4) 60%, rgba(0, 0, 0, 0.15) 100%);
				z-index: 2;
			}
			.tag-hero-content {
				position: relative;
				z-index: 3;
				max-width: 680px;
				background: rgba(0, 0, 0, 0.4);
				backdrop-filter: blur(20px);
				-webkit-backdrop-filter: blur(20px);
				border: 1px solid rgba(255, 255, 255, 0.12);
				border-radius: 20px;
				padding: 2.5rem;
				box-shadow: 0 12px 40px 0 rgba(0, 0, 0, 0.4);
				text-align: left;
			}
			.tag-title {
				font-family: 'Outfit', sans-serif;
				font-size: 0.85rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 3px;
				color: #e15f41;
				margin: 0 0 0.75rem 0;
				display: inline-block;
				background: rgba(225, 95, 65, 0.18);
				padding: 4px 14px;
				border-radius: 20px;
				border: 1px solid rgba(225, 95, 65, 0.3);
			}
			.tag-subtitle {
				font-family: 'Montserrat', sans-serif;
				font-size: 2.3rem;
				font-weight: 800;
				margin: 0 0 1rem 0;
				line-height: 1.15;
				color: #ffffff;
				text-shadow: 0 2px 10px rgba(0,0,0,0.3);
			}
			.tag-description {
				font-family: 'Outfit', sans-serif;
				font-size: 1.05rem;
				line-height: 1.6;
				color: rgba(255, 255, 255, 0.88);
				margin: 0;
			}
			
			/* Grid Styles */
			ul {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 2.5rem;
				list-style-type: none;
				margin: 0 0 4rem 0;
				padding: 0;
			}
			ul li {
				background: white;
				border-radius: 16px;
				overflow: hidden;
				box-shadow: 0 5px 15px rgba(0,0,0,0.03);
				border: 1px solid rgba(0,0,0,0.04);
				transition: transform 0.3s ease, box-shadow 0.3s ease;
			}
			ul li * {
				text-decoration: none;
			}
			ul li img {
				width: 100%;
				height: 240px;
				object-fit: cover;
				display: block;
				border-bottom: 1px solid rgba(0,0,0,0.04);
				transition: transform 0.5s ease;
			}
			ul li a {
				display: block;
			}
			.post-card-content {
				padding: 1.5rem;
			}
			.post-title {
				font-family: 'Outfit', sans-serif;
				margin: 0 0 0.5rem 0;
				color: #2f3640;
				line-height: 1.3;
				font-size: 1.35rem;
				font-weight: 700;
				transition: color 0.2s ease;
			}
			.date {
				margin: 0;
				color: #7f8c8d;
				font-family: 'Outfit', sans-serif;
				font-size: 0.85rem;
				font-weight: 500;
			}
			
			/* Hover Effects */
			ul li:hover {
				transform: translateY(-6px);
				box-shadow: 0 15px 30px rgba(0,0,0,0.08);
			}
			ul li:hover .post-title {
				color: #0052D4;
			}
			ul li:hover img {
				transform: scale(1.02);
			}

			@media (max-width: 768px) {
				main {
					padding: 0 1rem;
				}
				ul {
					grid-template-columns: 1fr;
					gap: 2rem;
				}
				.tag-hero {
					padding: 2rem 1.5rem;
					min-height: 320px;
					border-radius: 16px;
					margin-bottom: 2.5rem;
				}
				.tag-hero-content {
					padding: 1.5rem;
					border-radius: 16px;
				}
				.tag-subtitle {
					font-size: 1.8rem;
				}
				.tag-description {
					font-size: 0.95rem;
				}
				ul li img {
					height: 200px;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="tag-hero">
				<div class="tag-hero-bg" style={`background-image: url('${meta.image}');`}></div>
				<div class="tag-hero-overlay"></div>
				<div class="tag-hero-content">
					<span class="tag-title">{meta.title}</span>
					<h1 class="tag-subtitle">{meta.subtitle}</h1>
					<p class="tag-description">{meta.description}</p>
				</div>
			</div>
			
			<section>
				<ul>
					{
						sortedPosts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
										<img src={post.data.heroImage} alt={post.data.title} />
									)}
									<div class="post-card-content">
										<h4 class="post-title">{post.data.title}</h4>
										<p class="date">
											<FormattedDate date={post.data.pubDate} />
										</p>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
